# نمونه تنظیمات ربات بله نورا. مقدار واقعی را فقط روی سرور در /etc/nora/bale-bot.env بگذارید.
BOT_TOKEN=
SUPER_ADMIN_ID=
# ⚠️ فقط «مبدأ» را بنویسید؛ مسیر /api را خودِ ربات اضافه می‌کند.
# نوشتن https://lifeline1.ir/api باعث خطای shared_api_url_invalid و اجرا نشدن ربات می‌شود.
NORA_SHARED_API_URL=https://lifeline1.ir
NORA_BOT_SERVICE_TOKEN=
NORA_WEBAPP_URL=https://lifeline1.ir
DB_PATH=/opt/nora/data/nora-bot.sqlite3
# سقف هر تعدیل دستی امتیاز توسط مالک ربات (دفترکل، فاز ششم). خالی/۰ = تعدیل دستی غیرفعال (fail-closed).
# عدد را فقط پس از تصمیم مالک بگذارید؛ این سقف قاعدهٔ امتیازدهی جدیدی نیست.
POINTS_MANUAL_ADJUST_MAX=
# اختیاری: کلید و شناسه‌ی سرویس سفیر (فقط اگر ارسال OTP فعال است)
SAFIR_API_KEY=
SAFIR_BOT_ID=
