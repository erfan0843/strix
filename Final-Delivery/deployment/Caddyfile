# قالب Caddy برای HTTPS خودکار و reverse proxy به نورا روی 127.0.0.1:8000
# دامنه‌ی زیر فقط نمونه است؛ قبل از استفاده، رکورد DNS را به IP سرور اشاره دهید.
lifeline1.ir, www.lifeline1.ir {
    encode zstd gzip
    reverse_proxy 127.0.0.1:8000
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # فاز ۹.۲ — CSP پیشنهادی برای قاب‌های ویدیو (فعال نیست؛ در این مخزن در مرورگر واقعی آزموده نشده).
        # پخش‌کنندهٔ محتوای ضبط‌شده فقط از دو مبدأ رسمی قاب می‌سازد (event-interaction.js → EMBED_ORIGINS):
        #   youtube-nocookie.com و aparat.com. 'self' برای پیش‌نمایش PDF و loading-preview.html لازم است.
        # پیش از فعال‌کردن، صفحه‌های رویداد/حساب/پنل را با ویدیوی یوتیوب و آپارات در مرورگر آزمایش کنید.
        # Content-Security-Policy "frame-src 'self' https://www.youtube-nocookie.com https://www.aparat.com"
        # فاز ۹.۳ — فهرست کامل قاب‌های واقعی پروژه (اگر هر کدام در دادهٔ واقعی استفاده می‌شود باید در frame-src باشد):
        #   event-interaction.js و admin.js: youtube-nocookie.com, aparat.com
        #   ui.js پخش‌کنندهٔ قدیمی رسانهٔ رویداد: همان دو + player.vimeo.com + www.dailymotion.com
        #   ui.js نمایش PDF رسانه: نشانی خود رسانه (ممکن است بیرونی باشد) · loading-preview.html: 'self'
        # روش آزمون پیش از فعال‌سازی: در مرورگر واقعی با سرآیند Content-Security-Policy-Report-Only همین مقدار را
        # بگذارید، صفحه‌های event.html (ویدیوی یوتیوب + آپارات + PDF)، account.html، admin.html (پیش‌نمایش منبع) را
        # باز کنید و رویدادهای securitypolicyviolation (کنسول) را بررسی کنید؛ فقط پس از صفر شدن گزارش‌ها Enforce کنید.
    }
}
