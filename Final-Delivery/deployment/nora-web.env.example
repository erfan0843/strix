# نمونه تنظیمات وب‌سایت نورا. مقادیر واقعی را فقط روی سرور در /etc/nora/nora-web.env بگذارید.
# هرگز این فایل را با مقدار واقعی وارد Git یا ZIP عمومی نکنید.
NORA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@127.0.0.1:5432/nora
NORA_OWNER_ID=
NORA_OWNER_USERNAME=
NORA_OWNER_PASSWORD_HASH=
NORA_BALE_BOT_USERNAME=
NORA_BOT_SERVICE_TOKEN=
NORA_OWNER_BALE_USER_ID=
# توکن ربات بله: امضای مینی‌اپ با همین توکن اعتبارسنجی می‌شود. اگر خالی بماند
# هیچ خطری ایجاد نمی‌شود، ولی «پیوند حساب بله» در صفحهٔ حساب غیرفعال می‌شود
# (/api/account/identities → bale_link_available:false و پیوند ۵۰۳ می‌گیرد).
NORA_BALE_BOT_TOKEN=
# بیشینهٔ عمر امضای مینی‌اپ (ثانیه)؛ پیش‌فرض ۶۰۰ و بازهٔ مجاز ۶۰ تا ۳۶۰۰.
# امضای کهنه‌تر رد می‌شود، پس کاربری که صفحه را ساعت‌ها باز نگه داشته دوباره تلاش می‌کند.
NORA_BALE_INIT_DATA_MAX_AGE_SECONDS=600
# فلفل هش هویت (مستقل از کلید پیامک). تعویض آن همهٔ هویت‌های شماره‌ای را باطل می‌کند.
NORA_OTP_PEPPER=
NORA_SESSION_TTL_SECONDS=28800

# ── رمزنگاری اعتبارنامه‌ها (پنل → اتصال سرویس‌ها) ──────────────────────────
# کلید Fernet برای رمزنگاری توکن‌ها/کلیدهای ذخیره‌شده در پایگاه.
# باید مستقل از پایگاه‌داده، توکن ربات و توکن پرداخت باشد و هرگز در Git نباشد.
# ساخت کلید (یک‌بار؛ سپس همان مقدار را امن نگه دارید):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# بدون این کلید، ذخیرهٔ اعتبارنامه از پنل با خطای «کلید رمزنگاری تنظیم نشده» رد می‌شود.
NORA_SETTINGS_ENCRYPTION_KEY=

# ── پرداخت فرم (اختیاری؛ فقط اگر پرداخت فعال است) ─────────────────────────
# سه مقدار اول را می‌توان از پنل (تنظیمات ← اتصال سرویس‌ها ← پرداخت) هم ثبت کرد؛
# مقدار پایگاه بر مقدار محیطی اولویت دارد و همان مقدار مؤثر در وب مصرف می‌شود.
# دو توکن زیر دو چیز متفاوت‌اند و هرگز به‌جای هم استفاده یا کپی نمی‌شوند:
#   NORA_FORM_PAYMENT_BOT_TOKEN      = «توکن ربات پرداخت»: توکن Bot API رباتِ مستقل پرداخت
#                                      به شکل <شناسه>:<رمز>؛ در /bot<token>/ و HMAC مسیر وب‌هوک.
#   NORA_FORM_PAYMENT_PROVIDER_TOKEN = «توکن پرداخت کیف پول بله / Provider Token»: مقدار
#                                      provider_token در createInvoiceLink؛ برای پرداخت الزامی است.
# پرداخت فقط وقتی فعال می‌شود که هر چهار مقدار این بخش معتبر باشند.
NORA_FORM_PAYMENT_BOT_TOKEN=
NORA_FORM_PAYMENT_PROVIDER_TOKEN=
NORA_FORM_PAYMENT_WEBHOOK_SECRET=
NORA_FORM_PAYMENT_WEBHOOK_URL=

# ── داده‌ها و مهاجرت (بارگذاری نسخهٔ پشتیبان برای ممیزی) ────────────────
# پوشهٔ staging باید بیرون ریشهٔ وب باشد؛ خالی یعنی var/nora-data-staging
# کنار پوشهٔ nora-ui (خارج از مسیر سرو‌شدهٔ static).
NORA_DATA_STAGING_DIR=
# سقف هر فایل؛ پیش‌فرض ۲۵۶ مگابایت و بازهٔ مجاز ۱ مگابایت تا ۴ گیگابایت.
NORA_DATA_UPLOAD_MAX_BYTES=268435456
# نگه‌داری نسخه‌های پشتیبان؛ پیش‌فرض ۷۲ ساعت (۱ تا ۲۱۶۰).
NORA_DATA_STAGING_RETENTION_HOURS=72
# مسیر ابزار موجود ممیزی؛ خالی یعنی bale-bot/nora_bot/legacy_data_audit.py.
NORA_LEGACY_AUDIT_SCRIPT=
