# نمونهٔ غیرمحرمانه؛ به‌جای کپی دستی، local-dev.py init مسیر SQLite مطلق را می‌سازد.
# این نمونه هیچ سرویس خارجی، ورود مالک یا پرداختی را فعال نمی‌کند.
# NORA_DATABASE_URL توسط init در فایل خصوصی .env.local ساخته می‌شود.
NORA_DATABASE_URL=
NORA_OWNER_ID=local-owner
NORA_OWNER_USERNAME=
NORA_OWNER_PASSWORD_HASH=
NORA_COOKIE_SECURE=false
NORA_PUBLIC_BASE_URL=

# برای آزمون محلی خالی بمانند. هیچ credential واقعی را در این فایل قرار ندهید.
NORA_BALE_BOT_TOKEN=
NORA_BALE_BOT_USERNAME=
NORA_BOT_SERVICE_TOKEN=
NORA_OWNER_BALE_USER_ID=
NORA_FORM_PAYMENT_BOT_TOKEN=
NORA_FORM_PAYMENT_PROVIDER_TOKEN=
NORA_FORM_PAYMENT_WEBHOOK_SECRET=
NORA_FORM_PAYMENT_WEBHOOK_URL=
SAFIR_API_KEY=
SAFIR_BOT_ID=
NORA_OTP_PEPPER=
