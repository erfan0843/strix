# ═══════════════════════════════════════════════════════
#  تنظیمات ربات نورا — فاز ۷
#  این فایل را به .env تغییر نام بده
#  ⚠️ فایل .env را هرگز جایی paste نکن
# ═══════════════════════════════════════════════════════

# ── بله (اجباری) ───────────────────────────────────────
BOT_TOKEN=
SUPER_ADMIN_ID=100000001   # آیدی عددی بله مالک را اینجا بگذارید

# ── API مشترک سایت و ربات ───────────────────────────────
# پس از استقرار backend هم‌مبدأ با وب‌اپ روی دامنهٔ رسمی.
# ⚠️ فقط «مبدأ» را بنویسید: https://example.com
#    مسیر /api را خودِ ربات اضافه می‌کند؛ اگر آن را در این مقدار بگذارید
#    (مثل https://example.com/api) ربات با خطای shared_api_url_invalid
#    بالا نمی‌آید. http فقط برای localhost مجاز است.
NORA_SHARED_API_URL=
# این راز باید دقیقاً با NORA_BOT_SERVICE_TOKEN در backend یکی باشد؛ دسترسی نوشتن به فایل SQLite نمی‌دهد.
NORA_BOT_SERVICE_TOKEN=
NORA_SHARED_API_TIMEOUT_SECONDS=8
# پس از استقرار: نشانی HTTPS همین وب‌اپ روی دامنهٔ رسمی؛ Mini App نسخهٔ دوم سایت نیست.
# اگر دامنه هنوز به وب‌اپ وصل نشده، این مقدار را در محیط اجرا فعال نکنید.
NORA_WEBAPP_URL=https://lifeline1.ir

# ── 🔗 لینک‌های عمیق (کیوآرکد، دعوت، فرم، پرداخت) ───────
#
# 🎯 اگر روزی توکن یا آیدی ربات را عوض کردید:
#    ۱) BOT_TOKEN بالا را عوض کنید
#    ۲) BOT_USERNAME زیر را هم عوض کنید
#    همین. همهٔ لینک‌ها و کیوآرکدهای تازه خودکار درست می‌شوند.
#
# 💡 اگر خالی بگذارید، ربات خودش از بله می‌پرسد (getMe) و
#    نتیجه را وابسته به شناسهٔ توکن ذخیره می‌کند — یعنی با
#    عوض شدن توکن، خودکار دوباره می‌پرسد.
#
# ⚠️ بدون @ بنویسید
BOT_USERNAME=LifeLine_bot

# 🌐 دامنهٔ پیام‌رسان — معمولاً دست نمی‌خورد
BALE_DOMAIN=https://ble.ir


# ── سرویس سفیر: رمز یکبار مصرف ─────────────────────────
# ⚠️ SAFIR_BOT_ID شناسه «بات رمز یکبار مصرف» است، نه بات اصلی!
SAFIR_API_KEY=
SAFIR_BOT_ID=
SAFIR_SEND_REQUEST_ID=


# ── پرداخت کیف پول بله ─────────────────────────────────
# 🔴 توکن واقعی — پول واقعی جابه‌جا می‌شود!
PAYMENT_PROVIDER_TOKEN=

# 🧪 اگر خواستید تست کنید بدون جابه‌جایی پول، خط بالا را
#    کامنت کنید و این را فعال کنید:
# PAYMENT_PROVIDER_TOKEN=WALLET-TEST-REDACTED

CURRENCY_LABEL=

# 💡 روش پرداخت هر رویداد جداگانه در ویزارد انتخاب می‌شود:
#    ❌ غیرفعال | 💳 کارت به کارت | 🏦 کیف پول بله | 🔗 درگاه سفارشی

# 🛡️ محافظت‌های ایمنی پرداخت واقعی
# سقف مبلغ هر تراکنش (ریال) — جلوگیری از اشتباه تایپی
PAYMENT_MAX_AMOUNT=
# حداقل مبلغ
PAYMENT_MIN_AMOUNT=
# مبلغ فاکتور تست در /paytest (ریال)
PAYMENT_TEST_AMOUNT=
# تأیید دومرحله‌ای قبل از ارسال فاکتور واقعی
PAYMENT_CONFIRM=


# ── ری‌اکشن خودکار ─────────────────────────────────────
# ❤️ روی هر پیام کاربر عادی گذاشته می‌شود
AUTO_REACT_ENABLED=
AUTO_REACT_EMOJI=
AUTO_REACT_ADMINS=


# ── فرم رضایت‌سنجی ─────────────────────────────────────
ASK_REVIEW_ENABLED=
ASK_REVIEW_DELAY=


# ── هویت ربات ──────────────────────────────────────────
# 💡 اینها فقط «مقدار اولیه» هستند.
#    از فاز ۱۸-ج می‌توانید نام ربات و مجموعه را از داخل خود ربات
#    عوض کنید (بدون ری‌استارت):
#    💬 پشتیبانی و باشگاه › ℹ️ درباره ما و پشتیبانی › 🏷️ هویت ربات
BOT_NAME=
ORG_NAME=


# ── تنظیمات اختیاری ────────────────────────────────────
OTP_TTL_MINUTES=
OTP_MAX_ATTEMPTS=
OTP_RESEND_SECONDS=
STATE_TTL_MINUTES=

USERS_PER_PAGE=
EVENTS_PER_PAGE=
MAX_IMPORT_MB=
MAX_BACKUPS=

# 💾 بک‌آپ خودکار (فاز ۱۸-د)
#    هر چند ساعت یک‌بار خودکار بک‌آپ گرفته شود؟ (۰ = خاموش)
AUTO_BACKUP_HOURS=
#    چند نسخه روزانه نگه داشته شود؟
KEEP_DAILY_BACKUPS=
BROADCAST_RATE=

ATT_RADIUS_M=
STRICT_NATIONAL_ID=
FORCE_JOIN_FAIL_OPEN=
